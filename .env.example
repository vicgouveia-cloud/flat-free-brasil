# Flat Free Brasil - Environment Variables
# Copy to .env.local and fill in the values when Supabase is ready
# DO NOT commit .env.local to git

# Supabase (not connected yet - running in demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: App environment
NEXT_PUBLIC_APP_ENV=demo


# Public site URL used for canonical URLs, sitemap, robots and social metadata
NEXT_PUBLIC_SITE_URL=https://flatfreebrasil.com.br

# Optional GA4 measurement ID (example: G-XXXXXXXXXX)
# Leave blank until analytics is intentionally enabled for production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# Server-side destination for public contact requests
CONTACT_TO_EMAIL=contato@flatfreebrasil.com.br
CONTACT_FROM_EMAIL="Flat Free Brasil <contato@flatfreebrasil.com.br>"
# Server-only Resend key; never use NEXT_PUBLIC_ for this secret.
RESEND_API_KEY=
